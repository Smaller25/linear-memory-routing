# 설정 5 + 층 간 라우팅 공유: 0층이 고른 구간을 위층 전부가 읽는다(아이디어 b 전체).
MODEL_ARCH=mc                          # Memory Caching SSC
MODEL_SIZE=370m                        # 370M 프리셋
MAX_TOKENS=30e9                        # 총 학습 토큰
RUN_TAG=ce_sepgate_maxsim_share        # run 폴더 구분
MC_AUX_LOSS=span_copy_ce               # span 복사 정답 구간에 대한 라우터 CE
MC_AUX_WEIGHT=0.1                      # CE 가중치(설정 3에서 고른 값으로 맞춘다)
MC_GATE=sep_softmax                    # 섞는 비중은 별도 투영 W_g 로
MC_DESCRIPTOR=subblock8                # 구간을 32토큰 하위 블록 8개로 요약
MC_ROUTER=maxsim                       # 하위 블록 점수의 최댓값
MC_SHARE_FROM=0                        # 0층의 top-k 를 위층이 재사용
SB_NODES=2                             # 2노드 x 4 GPU (mc_370m.env 와 같게)
