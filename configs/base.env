# =============================================================================
# base.env — 모든 변수의 선언과 기본값. 다른 configs/*.env 는 여기 있는 변수만 덮어쓴다.
# 규칙: 한 줄에 KEY=value  # 설명. 공백·; 가 들어가는 값은 "큰따옴표"로 감싼다.
# 실행할 때 환경변수로 준 값(예: MAX_TOKENS=1e9 bash scripts/train.sh)이 파일보다 우선한다.
# =============================================================================

# === [paths] ===
SCRATCH_ROOT="/scratch/${USER}/mslm"   # 큰 파일(데이터·체크포인트·캐시)을 두는 곳. KISTI는 /scratch/$USER (15일 미접근 시 삭제)
DATA_ROOT="${SCRATCH_ROOT}/data"       # 데이터 최상위 폴더
RUNS_ROOT="${SCRATCH_ROOT}/runs"       # 학습 run(체크포인트·로그)이 쌓이는 폴더
HF_CACHE_DIR="${SCRATCH_ROOT}/hf_cache" # HF_HOME 으로 쓰는 캐시(토크나이저·원본 데이터셋)
BACKUP_ROOT=""                         # 체크포인트 백업 위치(비우면 백업 안 함). 예: /home01/$USER/mslm_backup
CONDA_ENV=sh_mslm                      # 활성화할 conda env 이름(비우면 현재 python 그대로 사용)
MODULES=""                             # 작업 시작 시 module load 할 목록(공백 구분). 예: "miniforge/26.1.1-3"

# === [model] ===
MODEL_ARCH=mc                          # vanilla(GDN-2) | mc(GDN-2 + Memory Caching SSC)
MODEL_SIZE=50m                         # 크기 프리셋: tiny | 50m | 370m (아래 N_LAYER 등이 비어 있으면 프리셋 값 사용)
N_LAYER=""                             # 층 수(비우면 프리셋)
D_MODEL=""                             # hidden 크기(비우면 프리셋)
N_HEAD=""                              # GDN-2 head 수(비우면 프리셋)
HEAD_DIM=""                            # GDN-2 head 차원 d_k=d_v(비우면 프리셋)
FFN_DIM=""                             # SwiGLU MLP 중간 크기(비우면 프리셋)
VOCAB_SIZE=32000                       # 어휘 크기(TinyLlama v1.1 = 32000)
GDN_BACKEND=auto                       # auto(CUDA면 fla 커널, CPU면 torch 참조구현) | fla | torch
MC_CHUNK=256                           # [mc] 구간 길이: 이 토큰 수마다 state 하나를 저장
MC_TOPK=4                              # [mc] 토큰마다 읽을 과거 구간 수 k
MC_DESCRIPTOR=meanpool                 # [mc] 구간 요약(descriptor) 방식. 등록부: mslm/models/registry.py
MC_ROUTER=dot                          # [mc] 라우터 점수 방식(u_t=W_u x_t 와 descriptor 내적)
MC_GATE=softmax                        # [mc] online + 선택 구간을 섞는 게이트
MC_CONNECT=independent                 # [mc] 구간 연결: independent(구간마다 0에서 시작) | chained(이전 state 이어받음)
MC_AUX_LOSS=none                       # [mc] 라우터 보조 손실 이름(none이면 LM 손실만)
MC_AUX_WEIGHT=0.0                      # [mc] 보조 손실 가중치
MC_READ_KERNEL=auto                    # [mc] 과거 state 읽기: auto(CUDA면 triton) | triton | torch

# === [data] ===
TOKENIZER=TinyLlama/TinyLlama_v1.1     # HF 토크나이저 이름(학습·평가 공통, 다르면 평가가 멈춘다)
HF_DATASET=HuggingFaceFW/fineweb-edu   # 학습 원본 데이터셋
HF_DATASET_CONFIG=sample-10BT          # 데이터셋 subset 이름(sample-10BT | sample-100BT | default ...)
TRAIN_DATA_DIR="${DATA_ROOT}/fineweb_edu_tinyllama" # 사전 토큰화된 학습 shard(.bin) 폴더
PRETOK_MAX_TOKENS=12e9                 # 사전 토큰화할 최대 토큰 수
PRETOK_VAL_TOKENS=20e6                 # 그중 검증(val)용으로 떼어 둘 토큰 수(학습에 안 쓰임)
PRETOK_SHARD_TOKENS=1e9                # shard 파일 하나의 토큰 수
PRETOK_WORKERS=32                      # 토큰화 병렬 프로세스 수
EVAL_DATA_DIR="${DATA_ROOT}/eval_ruler" # 평가(RULER) 데이터 폴더. 학습 폴더와 분리, 형식도 jsonl

# === [train] ===
RUN_NAME=""                            # run 이름(비우면 <MODEL_ARCH>_<MODEL_SIZE>_ctx<SEQ_LEN>_s<SEED>)
SEED=0                                 # 시드(모델 초기화·데이터 순서). 비교는 3시드(0,1,2) 권장
SEQ_LEN=8192                           # 학습 문맥 길이
GLOBAL_BATCH_TOKENS=524288             # step 당 토큰 수(0.5M). = SEQ_LEN x MICRO_BATCH x GPU수 x 누적횟수
MICRO_BATCH=1                          # GPU 하나가 한 번에 처리하는 시퀀스 수
MAX_TOKENS=10e9                        # 총 학습 토큰 수
LR=4e-4                                # 최대 학습률
MIN_LR_RATIO=0.1                       # cosine 끝 학습률 = LR x 이 값
WARMUP_FRAC=0.01                       # 전체 step 중 warmup 비율(1%)
WEIGHT_DECAY=0.1                       # AdamW weight decay(1차원 파라미터·A_log·dt_bias 제외)
BETA1=0.9                              # AdamW beta1
BETA2=0.95                             # AdamW beta2
GRAD_CLIP=1.0                          # gradient norm clipping
PRECISION=bf16                         # bf16(autocast) | fp32
ACT_CKPT=0                             # 1이면 block 단위 activation checkpointing(메모리 절약, 느려짐)
LOG_EVERY=10                           # 몇 step마다 train.jsonl 에 기록할지
VAL_EVERY=500                          # 몇 step마다 val loss 를 잴지(0이면 안 함)
VAL_BATCHES=8                          # val loss 에 쓸 micro-batch 수
SAVE_EVERY=500                         # 몇 step마다 체크포인트를 저장할지
KEEP_CKPTS=3                           # 최근 체크포인트 몇 개를 남길지
RESUME=auto                            # auto(있으면 이어서) | none(처음부터) | 체크포인트 경로
MAX_STEPS=0                            # 0이 아니면 이 step에서 멈춤(smoke test 용, LR 일정은 MAX_TOKENS 기준 유지)

# === [eval] ===
EVAL_CKPT=latest                       # latest(해당 run의 마지막) | 체크포인트 파일 경로
EVAL_TASKS=niah_single_1,niah_single_2,niah_single_3,niah_multikey_1,niah_multikey_2,niah_multikey_3,niah_multivalue # RULER NIAH 과제
EVAL_LENGTHS=4096,8192                 # 평가 문맥 길이들(쉼표 구분)
EVAL_NUM_SAMPLES=100                   # 과제·길이마다 문항 수
EVAL_DATA_SEED=42                      # 평가 문항 생성 시드(모든 모델이 같은 문항을 풀도록 고정)
EVAL_ROUTE=learned,oracle              # 라우팅 모드: learned | oracle(정답 구간 강제, 평가 전용). vanilla는 무시
EVAL_ANSWER_PREFIX=1                   # 1이면 RULER 공식대로 input 뒤에 answer_prefix 를 붙여 생성
EVAL_MAX_NEW_TOKENS=0                  # 0이면 RULER 기본(tokens_to_generate). 빠른 점검용으로만 줄인다
EVAL_LIMIT=0                           # 0이 아니면 과제마다 앞 N문항만(smoke test 용)
EVAL_OUT=""                            # 결과 폴더(비우면 <run>/eval/<체크포인트 이름>)

# === [slurm] ===
NGPU_PER_NODE=4                        # 노드당 GPU 수(torchrun nproc). KISTI GH200 노드 = 4
SB_JOB_NAME=sh_mslm                    # sbatch --job-name
SB_PARTITION=normal                    # sbatch --partition. KISTI GPU 큐: normal(베타) — TODO(확인 필요): 배정된 큐
SB_NODES=1                             # sbatch --nodes
SB_GPU_OPT=--gpus-per-node=4           # GPU 요청 옵션 그대로. KISTI 예제는 --gpus-per-node=4, greenbeard는 --gres=gpu:rtx6000:1
SB_CPUS_PER_TASK=72                    # sbatch --cpus-per-task (노드당 작업 1개 기준)
SB_TIME=24:00:00                       # sbatch --time. KISTI normal 최대 24h
SB_COMMENT="field=nlp;appl=pytorch"    # sbatch --comment. KISTI 필수(field/appl 허용값은 로그인 노드에서 showappl). 비우면 생략
SB_EXCLUSIVE=1                         # 1이면 --exclusive
SB_EXTRA=""                            # 그 밖의 sbatch 옵션 그대로(예: "--account=xxx")
SB_SUBMIT_DIR="${SCRATCH_ROOT}/jobs"   # sbatch 를 실행할 폴더. KISTI는 /scratch/$USER 아래에서만 제출 가능
SB_LOG_DIR="${SCRATCH_ROOT}/slurm_logs" # sbatch 표준출력/에러 로그 폴더
