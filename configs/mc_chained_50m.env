# MC 원본 + 끊지 않는 압축기(아이디어 d). 구간 state 가 앞 구간에서 이어진다.
MODEL_ARCH=mc                          # Memory Caching SSC
MODEL_SIZE=50m                         # 50M 프리셋
MAX_TOKENS=10e9                        # 총 학습 토큰
RUN_TAG=chained                        # run 폴더 구분
MC_CONNECT=chained                     # 이전 구간 state 를 이어받음(순차 실행이라 느리다)
