# KISTI 접속 직후 50M 연기 시험(smoke). GPU 1장, 몇 분 안에 끝난다. 레시피 변수 체계는 본학습과 같다.
MODEL_ARCH=mc                          # Memory Caching SSC
MODEL_SIZE=50m                         # 본학습과 같은 50M
SEQ_LEN=8192                           # 본학습과 같은 문맥 길이
GLOBAL_BATCH_TOKENS=65536              # 작은 배치(8 시퀀스)
MICRO_BATCH=2                          # GPU당 2 시퀀스 → 누적 4회
MAX_TOKENS=1e9                         # LR 일정 계산용(실제로는 MAX_STEPS에서 멈춤)
MAX_STEPS=20                           # 20 step 후 종료
LOG_EVERY=1                            # 매 step 기록
VAL_EVERY=10                           # 10 step마다 val
VAL_BATCHES=2                          # val 2 batch
SAVE_EVERY=10                          # 10 step마다 저장(재개 확인용)
RUN_NAME=smoke_mc_50m                  # run 이름 고정
EVAL_LENGTHS=8192                      # 한 길이만
EVAL_DATA_DIR="${DATA_ROOT}/eval_ruler_smoke" # 본평가 문항(100개)과 섞이지 않게 따로 둔다
EVAL_NUM_SAMPLES=4                     # 과제당 4문항 생성
EVAL_LIMIT=2                           # 과제당 2문항만 채점
EVAL_MAX_NEW_TOKENS=24                 # 빠른 점검용으로 생성 길이 축소(점수는 참고용)
NGPU_PER_NODE=1                        # GPU 1장
SB_GPU_OPT=--gres=gpu:1                # GPU 1장 요청
SB_CPUS_PER_TASK=""                    # 생략: natStr 는 비독점 GPU 작업의 --cpus-per-task 를 거부(GPU 수에 맞춰 자동 배정)
SB_TIME=01:00:00                       # 1시간(점검·학습·재개·평가를 작업 하나에서)
SB_EXCLUSIVE=0                         # 노드 공유 허용. TODO(확인 필요): 비독점 GPU 할당 허용 여부
