# 설정 6, MARCH식: 끊지 않는 압축기 + 과거 구간 전부를 softmax 로 섞기(고르지 않음).
MODEL_ARCH=mc                          # Memory Caching SSC
MODEL_SIZE=50m                         # 50M 프리셋
MAX_TOKENS=10e9                        # 총 학습 토큰
RUN_TAG=dense_chained                  # run 폴더 구분
MC_CONNECT=chained                     # 이전 구간 state 를 이어받음
MC_TOPK=1024                           # 구간 수보다 크게: 과거 구간 전부를 읽는다(8K/256 = 최대 31개)
