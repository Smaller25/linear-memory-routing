# 연구실 서버(greenbeard, RTX PRO 6000 1장) 연기 시험. 본학습과 같은 변수 체계, 크기만 작다.
SCRATCH_ROOT=/data2/${USER}/mslm_smoke # greenbeard 큰 디스크
CONDA_ENV=/data2/${USER}/conda-envs/sh_mslm # setup/install_env.sh (ENV_PREFIX) 로 만든 env
MODULES=""                             # greenbeard 는 module 불필요
MODEL_ARCH=mc                          # Memory Caching SSC
MODEL_SIZE=50m                         # 50M
SEQ_LEN=2048                           # 짧은 문맥
GLOBAL_BATCH_TOKENS=16384              # 8 시퀀스
MICRO_BATCH=4                          # 누적 2회
MAX_TOKENS=1e8                         # LR 일정 계산용
MAX_STEPS=12                           # 12 step 후 종료
LOG_EVERY=1                            # 매 step 기록
VAL_EVERY=6                            # 6 step마다 val
VAL_BATCHES=2                          # val 2 batch
SAVE_EVERY=6                           # 6 step마다 저장
PRETOK_MAX_TOKENS=4e7                  # 4천만 토큰만 토큰화
PRETOK_VAL_TOKENS=1e6                  # val 100만 토큰
PRETOK_SHARD_TOKENS=2e7                # shard 2천만 토큰
PRETOK_WORKERS=8                       # 8 프로세스
RUN_NAME=smoke_gb_mc_50m               # run 이름 고정
EVAL_LENGTHS=2048                      # 평가 길이
EVAL_NUM_SAMPLES=4                     # 과제당 4문항 생성
EVAL_LIMIT=2                           # 과제당 2문항 채점
EVAL_MAX_NEW_TOKENS=24                 # 생성 길이 축소
NGPU_PER_NODE=1                        # GPU 1장
SB_PARTITION=main                      # greenbeard 파티션
SB_GPU_OPT=--gres=gpu:rtx6000:1        # greenbeard GPU 요청 형식
SB_CPUS_PER_TASK=8                     # CPU 8
SB_TIME=01:00:00                       # 1시간
SB_COMMENT=""                          # greenbeard는 --comment 불필요
SB_EXCLUSIVE=0                         # 공유 노드
