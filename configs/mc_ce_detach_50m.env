# 설정 4 의 라우터 분리판: 라우터가 detach 한 hidden 에 전용 W_q/W_k 를 써서 CE 가 backbone 에 닿지 않는다
# (DeepSeek-V3.2 indexer 식). 점수는 cosine x 학습 온도(WSS 식). LM 손실은 MC 원본과 경쟁 없이 배운다.
MODEL_ARCH=mc                          # Memory Caching SSC
MODEL_SIZE=50m                         # 50M 프리셋
MAX_TOKENS=10e9                        # 총 학습 토큰
RUN_TAG=ce_detach                      # run 폴더 구분
MC_AUX_LOSS=span_copy_ce               # span 복사 정답 구간에 대한 라우터 CE
MC_AUX_WEIGHT=1.0                      # CE 가중치(backbone 과 분리돼 LM 손실을 건드리지 않는다)
MC_GATE=sep_softmax                    # 섞는 비중은 별도 투영 W_g 로(LM 손실로만)
MC_ROUTER=detached_cos                 # 라우터 전용 W_q/W_k, 입력 detach, cosine x gamma
