# Stage 2: detach 라우터(E7) 틀을 고정하고 라우터가 쓰는 descriptor 만 바꾼다. backbone descriptor(게이트용)는 meanpool 그대로.
# 바꿀 descriptor 는 MC_ROUTER_DESCRIPTOR 로 준다(subblock8/16/32, boundary, centered, mma, keyconv). 기본은 E7 의 최고 설정.
MODEL_ARCH=mc                          # Memory Caching SSC
MODEL_SIZE=370m                        # 370M 프리셋
MAX_TOKENS=30e9                        # 총 학습 토큰
RUN_TAG=ce_detach_desc                 # run 폴더 구분(descriptor 마다 바꿀 것)
MC_AUX_LOSS=span_copy_ce               # span 복사 정답 구간에 대한 라우터 CE
MC_AUX_WEIGHT=0.3                      # CE 가중치(E7 에서 1.0 과 차이 없음, 0.3 고정)
MC_GATE=sep_softmax                    # 섞는 비중은 별도 투영 W_g 로(LM 손실로만)
MC_ROUTER=detached_cos                 # 라우터 전용 W_q/W_k, 입력 detach, cosine x gamma
MC_ROUTER_DESCRIPTOR=subblock8         # 라우터 key 요약 방식(이 변수만 바꿔 비교)
SB_NODES=2                             # 2노드 x 4 GPU (mc_370m.env 와 같게)
