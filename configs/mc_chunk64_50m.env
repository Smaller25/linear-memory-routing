# MC 원본 + 작은 구간(아이디어 e). 64토큰마다 state 하나, 읽는 수 k 는 그대로 4.
MODEL_ARCH=mc                          # Memory Caching SSC
MODEL_SIZE=50m                         # 50M 프리셋
MAX_TOKENS=10e9                        # 총 학습 토큰
RUN_TAG=chunk64                        # run 폴더 구분
MC_CHUNK=64                            # 구간 길이 64토큰(8K 문맥에 128개)
